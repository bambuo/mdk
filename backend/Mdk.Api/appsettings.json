{
  "Binance": {
    "RestBaseUrl": "https://api.binance.com",
    "WsBaseUrl": "wss://stream.binance.com:9443",
    "FuturesRestBaseUrl": "https://fapi.binance.com",
    "FuturesWsBaseUrl": "wss://fstream.binance.com/market"
  },
  "Signal": {
    "OutcomeHorizonBars": 12,
    "WatchlistEnabled": true,
    "WatchlistIntervalSeconds": 120
  },
  "Chan": {
    "Enabled": true,
    "StrokeMode": "Loose",
    "DivergenceAreaRatio": 0.9,
    "MaxPoints": 50,
    "WarmupBars": 30,
    "AnalysisBars": 700,
    "RequireSubLevelConfirm": true,
    "SubLevelConfirmWindowBars": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backfill": {
    "RunOnStartup": true,
    "StartupDelaySeconds": 40,
    "Days": 90,
    "Symbols": [
      "BTCUSDT",
      "ETHUSDT",
      "SOLUSDT",
      "BNBUSDT",
      "XRPUSDT"
    ],
    "Intervals": [
      "1h",
      "4h"
    ]
  }
}
